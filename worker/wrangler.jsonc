{
  // Deployed automatically from GitHub (Cloudflare Workers Builds). Secrets are NOT stored here:
  // BREVO_API_KEY and TURNSTILE_SECRET live in Cloudflare only (Settings > Variables and Secrets).
  "name": "clarity-report",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "FROM_EMAIL": "info@leadwithfx.com",
    "ALERT_EMAIL": "leadwithfx@gmail.com",
    "BREVO_LIST_ID": "3"
    // Test mode: add "DRY_RUN": "1" here (and push) to build reports without sending anything.
  },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // Retry outbox for failed Brevo calls (table defined in schema.sql). Rows exist only while a send is failing.
  "d1_databases": [
    { "binding": "DB", "database_name": "clarity-outbox", "database_id": "9a279783-e563-428f-bc46-f7bb20a1a263" }
  ],
  // Every 5 minutes: retry anything in the outbox that is due.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
